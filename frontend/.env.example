# LCCA-CPPM frontend — environment variables
#
# Copy this file to `.env.local` for local development, OR set these as
# Project → Settings → Environment Variables in Vercel for deployment.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Base URL of the Django REST API the frontend should call.
# Local dev:   http://127.0.0.1:8000/api
# Production:  https://<your-backend-host>/api
VITE_API_URL=http://127.0.0.1:8000/api
