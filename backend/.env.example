# LCCA-CPPM backend — environment variables
#
# Copy this file to `.env` for local development, or configure these in your
# hosting provider (Render / Railway / Fly.io / Heroku / PythonAnywhere).

# Django core
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — defaults to SQLite if unset.
# Examples:
#   sqlite:///db.sqlite3
#   postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# CORS — comma-separated absolute origins the frontend will call from.
# Add your Vercel production URL plus any custom domain here.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional — comma-separated regex patterns for allowed origins.
# Allows every Vercel preview/branch deploy:
#   CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=
